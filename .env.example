# PostgreSQL Database URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/incidentflow?schema=public"

# Backend Server Configuration
PORT=4000
NODE_ENV=development

# JWT Secret for User Authentication
JWT_SECRET="development-jwt-secret-incidentflow-2026"
JWT_EXPIRES_IN="7d"

# Webhook Ingress Secret
# Generate a unique value with: openssl rand -hex 32
WEBHOOK_SECRET="replace-with-a-long-random-secret"

# Optional OTLP collector endpoint for API traces and metrics (for example, http://localhost:4318).
# Leave unset to keep telemetry local to /api/metrics and structured request logs.
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"

# Frontend API Base URL (used by Vite)
VITE_API_URL="http://localhost:4000/api"
